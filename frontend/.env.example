# Browser-facing API URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Used by server-side rendering. With Docker Compose this is http://backend:5000/api
API_INTERNAL_URL=http://localhost:5000/api
# Set the canonical origin at build time. Enable indexing on the public deployment only.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ALLOW_INDEXING=false
