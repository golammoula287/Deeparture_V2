NODE_ENV=development
PORT=5000
DATABASE_URL=mongodb://127.0.0.1:27017/deeparture_v2
JWT_SECRET_KEY=replace-with-a-long-random-secret
BCRYPT_SALT_ROUNDS=10
FRONTEND_URL=http://localhost:3000

# Optional real SMTP. Leave blank locally to use Nodemailer's safe JSON transport.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Deeparture <no-reply@example.test>

# Used by npm run create:admin
ADMIN_NAME=Deeparture Admin
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=ChangeThisBeforeUse123!

# Optional demo seed login
DEMO_OPERATOR_EMAIL=operator@example.test
DEMO_OPERATOR_PASSWORD=ChangeMe123!
