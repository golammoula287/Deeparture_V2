{
  "name": "deeparture-v2-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Deeparture V2 API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "check": "node scripts/check-v2-syntax.js",
    "seed:attributes": "node scripts/seed-v2-attributes.js",
    "seed:demo": "node scripts/seed-demo.js",
    "create:admin": "node scripts/create-admin.js",
    "refresh:pricing": "node scripts/refresh-v2-pricing.js",
    "test": "node --test tests/*.test.js",
    "verify:phase1": "node scripts/verify-phase1.js",
    "verify:phase1:local": "node scripts/verify-phase1-local.js",
    "verify:phase2a": "node scripts/verify-phase2a.js",
    "verify:phase2a:local": "node scripts/verify-phase1-local.js",
    "verify:phase2b:static": "node scripts/verify-phase2b-static.js",
    "verify:phase2b": "npm run check && npm run verify:phase2b:static && npm test",
    "verify:phase2b:local": "node scripts/verify-phase1-local.js --phase2b-only",
    "verify:phase3:static": "node scripts/verify-phase3-static.js",
    "verify:phase3": "npm run check && npm run verify:phase2b:static && npm run verify:phase3:static && npm test",
    "migrate:phase3:media": "node scripts/migrate-phase3-media.js",
    "verify:phase3:local": "node scripts/verify-phase1-local.js --phase2b --phase3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "http-status": "^1.7.4",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.3",
    "multer": "^2.0.0",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
